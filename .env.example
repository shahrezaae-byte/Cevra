# Required: Anthropic API key used for requirement extraction and option comparison.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: SerpApi key (https://serpapi.com/) used for live product research.
# If this is not set, the app will clearly tell users that live research is
# unavailable rather than fabricating product data.
SEARCH_API_KEY=
